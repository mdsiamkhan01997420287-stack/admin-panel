<%- include('../partials/header', { title: 'পোস্ট ম্যানেজার' }) %>

<div class="page-header">
  <div>
    <h2>পোস্ট ম্যানেজার</h2>
    <p>সব পোস্ট তৈরি, সম্পাদনা ও মুছুন।</p>
  </div>
  <a href="/admin/posts/new" class="btn btn-primary"><i class="fas fa-plus"></i> নতুন পোস্ট</a>
</div>

<div class="card">
  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-file-alt"></i>
      <p>এখনো কোনো পোস্ট নেই। প্রথম পোস্টটি তৈরি করুন!</p>
      <br>
      <a href="/admin/posts/new" class="btn btn-primary"><i class="fas fa-plus"></i> নতুন পোস্ট</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>শিরোনাম</th>
            <th>স্ট্যাটাস</th>
            <th>ট্যাগ</th>
            <th>তারিখ</th>
            <th>অ্যাকশন</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(post => { %>
          <tr>
            <td style="color:var(--text);font-weight:500;max-width:300px">
              <%= post.title %>
              <div style="font-size:11px;color:var(--text3);margin-top:4px;font-family:'JetBrains Mono',monospace"><%= post.id.slice(0,8) %>...</div>
            </td>
            <td>
              <span class="badge <%= post.status === 'published' ? 'badge-success' : 'badge-warning' %>">
                <%= post.status === 'published' ? '✓ প্রকাশিত' : '⏸ ড্রাফট' %>
              </span>
            </td>
            <td>
              <% (post.tags || []).slice(0,3).forEach(tag => { %>
                <span class="badge" style="background:rgba(108,99,255,0.1);color:var(--accent);margin-right:4px">#<%= tag %></span>
              <% }) %>
            </td>
            <td style="font-family:'JetBrains Mono',monospace;font-size:12px;white-space:nowrap">
              <%= new Date(post.createdAt).toLocaleString('bn-BD') %>
            </td>
            <td>
              <div style="display:flex;gap:8px">
                <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-ghost btn-sm">
                  <i class="fas fa-edit"></i> সম্পাদনা
                </a>
                <form method="POST" action="/admin/posts/delete/<%= post.id %>" style="display:inline">
                  <button type="submit" class="btn btn-danger btn-sm" data-confirm="এই পোস্টটি মুছে ফেলবেন?">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
