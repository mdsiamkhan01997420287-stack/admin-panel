<%- include('partials/header', { title: 'ড্যাশবোর্ড' }) %>

<div class="page-header">
  <div>
    <h2>স্বাগতম, <%= user %>! 👋</h2>
    <p>আপনার অ্যাডমিন প্যানেলে সব কিছু ঠিক আছে।</p>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
    <div class="stat-value"><%= stats.posts %></div>
    <div class="stat-label">মোট পোস্ট</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
    <div class="stat-value"><%= stats.published %></div>
    <div class="stat-label">প্রকাশিত পোস্ট</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><i class="fas fa-images"></i></div>
    <div class="stat-value"><%= stats.images %></div>
    <div class="stat-label">আপলোড করা ছবি</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><i class="fas fa-folder"></i></div>
    <div class="stat-value"><%= stats.files %></div>
    <div class="stat-label">আপলোড করা ফাইল</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
  <!-- Recent Posts -->
  <div class="card">
    <div class="card-title"><i class="fas fa-clock"></i> সাম্প্রতিক পোস্ট</div>
    <% if (recentPosts.length === 0) { %>
      <div class="empty-state" style="padding:32px">
        <i class="fas fa-file-alt"></i>
        <p>এখনো কোনো পোস্ট নেই</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>শিরোনাম</th><th>স্ট্যাটাস</th><th>তারিখ</th></tr></thead>
          <tbody>
            <% recentPosts.forEach(post => { %>
            <tr>
              <td style="color:var(--text);font-weight:500"><%= post.title %></td>
              <td>
                <span class="badge <%= post.status === 'published' ? 'badge-success' : 'badge-warning' %>">
                  <%= post.status === 'published' ? 'প্রকাশিত' : 'ড্রাফট' %>
                </span>
              </td>
              <td style="font-family:'JetBrains Mono',monospace;font-size:12px">
                <%= new Date(post.createdAt).toLocaleDateString('bn-BD') %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <div style="margin-top:16px">
      <a href="/admin/posts" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-right"></i> সব পোস্ট দেখুন</a>
    </div>
  </div>
  
  <!-- Quick Actions -->
  <div class="card">
    <div class="card-title"><i class="fas fa-bolt"></i> দ্রুত অ্যাকশন</div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <a href="/admin/posts/new" class="btn btn-primary" style="justify-content:center">
        <i class="fas fa-plus"></i> নতুন পোস্ট লিখুন
      </a>
      <a href="/admin/images" class="btn btn-ghost" style="justify-content:center">
        <i class="fas fa-image"></i> ছবি আপলোড করুন
      </a>
      <a href="/admin/files" class="btn btn-ghost" style="justify-content:center">
        <i class="fas fa-upload"></i> ফাইল আপলোড করুন
      </a>
      <a href="/admin/settings" class="btn btn-ghost" style="justify-content:center">
        <i class="fas fa-cog"></i> সেটিংস পরিবর্তন করুন
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

